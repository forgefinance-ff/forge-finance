# Copie para .env.local e preencha. Nunca envie o .env.local para o Git.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# IA (assistente e bot)
ANTHROPIC_API_KEY=
AI_MODEL=
WHATSAPP_AI_MODEL=

# Áudio no WhatsApp
OPENAI_API_KEY=
WHISPER_MODEL=

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_WEEKLY_TEMPLATE=
WHATSAPP_MONTHLY_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANG=pt_BR

# Login com Google: true mostra o botão (precisa do provedor ligado no Supabase)
NEXT_PUBLIC_GOOGLE_AUTH=

# Cobrança (Stripe)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Forge Pessoal: R$ 19,90/mês e R$ 199/ano
STRIPE_PRICE_PESSOAL_MONTHLY=
STRIPE_PRICE_PESSOAL_YEARLY=
# Forge MEI: R$ 29,90/mês e R$ 299/ano
STRIPE_PRICE_MEI_MONTHLY=
STRIPE_PRICE_MEI_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Pix Automático nas assinaturas: true só depois de ativar o Pix no Stripe
STRIPE_PIX_ENABLED=false

# Pixel da Meta (anúncios): só os números do ID do conjunto de dados. Vazio = desligado.
NEXT_PUBLIC_META_PIXEL_ID=
# Utmify: true carrega o script de UTMs; o token envia as vendas pagas (Integrações > Webhooks > Credenciais de API)
NEXT_PUBLIC_UTMIFY_ENABLED=false
# ID do Pixel na Utmify (Pixels > Código do Pixel), 24 letras/números
NEXT_PUBLIC_UTMIFY_PIXEL_ID=
UTMIFY_API_TOKEN=

# Dados de quem vende, mostrados no rodapé e nos Termos de Uso
NEXT_PUBLIC_SELLER_CPF=
NEXT_PUBLIC_SELLER_ADDRESS=

# Suporte (balão no app)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Monitoramento (opcional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Painel admin (/admin): e-mails com acesso, separados por vírgula.
ADMIN_EMAILS=
# Opcional: cotação do dólar usada no custo real da IA no painel (padrão: 5.15).
ADMIN_USD_BRL=
# Aviso de suporte no WhatsApp dos admins. Vazio = usa o WhatsApp que cada e-mail de ADMIN_EMAILS conectou no app.
# Ou números fixos, só dígitos com DDI, separados por vírgula (ex.: 5521999999999).
ADMIN_WHATSAPP=
# Modelo aprovado na Meta para o aviso (chega mesmo fora da janela de 24 h). Ex.: suporte_nova_mensagem
WHATSAPP_SUPPORT_TEMPLATE=
# Números que o bot ignora sem responder (robôs de empresas), só dígitos, separados por vírgula.
WHATSAPP_IGNORE_NUMBERS=
