# Copie para .env.local e preencha. Nunca envie o .env.local para o Git.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# IA (assistente e bot)
ANTHROPIC_API_KEY=
AI_MODEL=
WHATSAPP_AI_MODEL=

# Áudio no WhatsApp
OPENAI_API_KEY=
WHISPER_MODEL=

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_WEEKLY_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE_LANG=pt_BR

# Cobrança (Stripe)
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Suporte (balão no app)
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Monitoramento (opcional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Painel admin (/admin): e-mails com acesso, separados por vírgula.
ADMIN_EMAILS=
# Opcional: custo médio estimado por consulta de IA, em reais (ex.: 0.02), para o painel estimar gastos.
ADMIN_AI_COST_PER_REQUEST=
# Aviso de suporte no WhatsApp dos admins. Vazio = usa o WhatsApp que cada e-mail de ADMIN_EMAILS conectou no app.
# Ou números fixos, só dígitos com DDI, separados por vírgula (ex.: 5521999999999).
ADMIN_WHATSAPP=
# Modelo aprovado na Meta para o aviso (chega mesmo fora da janela de 24 h). Ex.: suporte_nova_mensagem
WHATSAPP_SUPPORT_TEMPLATE=
